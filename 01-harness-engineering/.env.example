# Copy this file to `.env` (same folder) and fill in ONE provider block.
# `.env` is git-ignored, so your key never ends up on GitHub.

# --- Option A: Google Gemini, free tier. Key: https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
LLM_API_KEY=paste-your-key-here
LLM_MODEL=gemini-3.5-flash-lite

# --- Option B: Groq, free tier. Key: https://console.groq.com/keys
# LLM_PROVIDER=groq
# LLM_API_KEY=paste-your-key-here
# LLM_MODEL=llama-3.3-70b-versatile

# --- Option C: a local model with Ollama, no key, no account (slow on a laptop)
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b

# --- Any other OpenAI-compatible API
# LLM_BASE_URL=https://example.com/v1
# LLM_API_KEY=...
# LLM_MODEL=...

# Free tiers cap requests per minute. 4.5 seconds between calls stays under 15 per minute.
# Set to 0 on a paid key.
LLM_MIN_SECONDS_BETWEEN_CALLS=4.5

# Max tokens per model reply. 8192 is a common default output limit.
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0
